---
import Layout from "@/layouts/main.astro"
import { Button } from "@/components/ui/button"
---

<Layout>
  <div class="flex min-h-svh p-6">
    <div class="flex max-w-md min-w-0 flex-col gap-4 text-sm leading-loose">
      <div>
        <h1 class="font-medium">Project ready!</h1>
        <p>You may now add components and start building.</p>
        <p>Open the blog demo to see internal linking in action.</p>
        <Button client:load asChild className="mt-2">
          <a href="/blog">View blog demo</a>
        </Button>
      </div>
    </div>
  </div>
</Layout>
