---
import { getBlogArticles, targetsFor, titleFor } from "@/lib/blog"
import Layout from "@/layouts/main.astro"

const articles = await getBlogArticles()
---

<Layout>
  <main class="mx-auto max-w-2xl px-6 py-12">
    <div class="mb-8">
      <p class="font-mono text-xs tracking-wider text-muted-foreground uppercase">
        Internal linking demo
      </p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight">Blog</h1>
      <p class="mt-3 text-sm leading-7 text-muted-foreground">
        Three Markdown articles form a small content graph with `slug`,
        `linksTo`, `aliases`, and `keywords` frontmatter.
      </p>
    </div>

    <div class="grid gap-3">
      {
        articles.map((article) => (
          <a
            href={`/blog/${article.meta.slug}`}
            class="rounded-lg border bg-card px-4 py-3 text-sm transition-colors hover:bg-muted"
          >
            <span class="block font-medium">{article.meta.title}</span>
            <span class="mt-1 block text-xs text-muted-foreground">
              Links to {targetsFor(article).map((slug) => titleFor(slug, articles)).join(", ")}
            </span>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
