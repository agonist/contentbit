---
import type { StepsData } from '@contentbit/blocks'
import type { ValidatedBlockNode } from '@contentbit/core'

import { renderMarkdownToHtml } from '@/lib/markdown'

interface Props {
  node: ValidatedBlockNode<unknown>
}

const { node } = Astro.props
const data = node.data as StepsData
const last = data.items.length - 1
const items = await Promise.all(
  data.items.map(async (item) => ({
    html: await renderMarkdownToHtml(item.text),
  })),
)
---

<ol data-cb-styled class="my-6 list-none p-0">
  {
    items.map((item, i) => (
      <li class="relative flex gap-4 pb-7 last:pb-0">
        {i < last ? <span class="bg-border absolute top-7 bottom-1 left-[13px] w-px" aria-hidden="true" /> : null}
        <span class="bg-card text-foreground z-10 flex size-7 shrink-0 items-center justify-center rounded-full border font-mono text-xs font-semibold shadow-sm">
          {i + 1}
        </span>
        <div class="min-w-0 pt-1 text-sm leading-relaxed [&>p]:m-0 [&>p+p]:mt-2" set:html={item.html} />
      </li>
    ))
  }
</ol>
