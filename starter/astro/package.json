{
  "name": "astro",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "astro check",
    "content:check": "contentbit validate \"content/**/*.md\" --registry ./blocks/registry.ts",
    "content:links": "contentbit links \"content/**/*.md\"",
    "content:doctor": "contentbit doctor \"content/**/*.md\" --registry ./blocks/registry.ts",
    "studio": "contentbit studio \"content/**/*.md\" --registry ./blocks/registry.ts",
    "smoke": "node ../../scripts/starter-smoke.mjs astro"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.1",
    "@astrojs/react": "^6.0.0",
    "@contentbit/astro": "^0.6.1",
    "@contentbit/blocks": "^0.6.1",
    "@contentbit/core": "^0.6.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "astro": "^7.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.5.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@contentbit/studio": "^0.6.1",
    "contentbit": "^0.6.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "typescript": "~6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
