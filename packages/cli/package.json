{
  "name": "contentbit",
  "version": "0.4.2",
  "description": "CLI for Content Blocks: validate, render, and generate LLM authoring instructions from your registry.",
  "keywords": [
    "cli",
    "content-blocks",
    "llm",
    "markdown",
    "validation"
  ],
  "homepage": "https://contentbit.dev",
  "bugs": "https://github.com/agonist/contentbit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonist/contentbit.git",
    "directory": "packages/cli"
  },
  "bin": {
    "contentbit": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/run.d.ts",
      "import": "./dist/run.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build.mjs",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.5.1",
    "@contentbit/blocks": "workspace:*",
    "@contentbit/core": "workspace:*",
    "@contentbit/studio": "workspace:*",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22.18"
  }
}
