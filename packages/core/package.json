    "directives",
    "content",
    "validation",
    "ast",
    "llm"
  ],
  "license": "MIT",
  "homepage": "https://contentbit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonist/contentbit.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/agonist/contentbit/issues",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
