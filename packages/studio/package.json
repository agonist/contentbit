{
  "name": "@contentbit/studio",
  "version": "0.4.1",
  "description": "Local read-only content studio for contentbit projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonist/contentbit.git",
    "directory": "packages/studio"
  },
  "files": [
    "dist",
    "src",
    "public",
    "components.json",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc -p tsconfig.server.json",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@contentbit/blocks": "workspace:*",
    "@contentbit/core": "workspace:*",
    "@contentbit/html": "workspace:*",
    "@contentbit/react": "workspace:*",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "@vitejs/plugin-react": "^6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.21.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tinyglobby": "^0.2.10",
    "tw-animate-css": "^1.4.0",
    "vite": "^8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^28",
    "typescript": "^6",
    "vitest": "^4"
  }
}
