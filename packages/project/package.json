{
  "name": "@contentbit/project",
  "version": "0.6.0",
  "description": "Node project loading utilities for contentbit adapters.",
  "homepage": "https://contentbit.dev",
  "bugs": "https://github.com/agonist/contentbit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonist/contentbit.git",
    "directory": "packages/project"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@contentbit/blocks": "workspace:*",
    "@contentbit/core": "workspace:*",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": ">=22.18"
  }
}
