{
  "name": "@contentbit/html",
  "version": "0.1.0",
  "description": "Static HTML renderer for Content Blocks documents. No framework, no JavaScript required.",
  "keywords": [
    "markdown",
    "content-blocks",
    "html",
    "renderer",
    "ssg"
  ],
  "license": "MIT",
  "homepage": "https://contentbit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonist/contentbit.git",
    "directory": "packages/html"
  },
  "bugs": "https://github.com/agonist/contentbit/issues",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@contentbit/blocks": "workspace:*",
    "@contentbit/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
