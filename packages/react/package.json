{
  "name": "@contentbit/react",
  "version": "0.1.0",
  "description": "React renderer for Content Blocks documents, with headless accessible defaults.",
  "keywords": [
    "markdown",
    "content-blocks",
    "react",
    "renderer",
    "headless"
  ],
  "license": "MIT",
  "homepage": "https://contentbit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonist/contentbit.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/agonist/contentbit/issues",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@contentbit/blocks": "workspace:*",
    "@contentbit/core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.0.0",
    "happy-dom": "^20.3.7",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
