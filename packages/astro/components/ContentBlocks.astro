---
import type { ValidatedDocumentNode } from '@contentbit/core'
import type { AstroBlockContext, AstroMarkdownRenderer } from '@contentbit/astro'

import { defaultRenderMarkdown } from '@contentbit/astro'
import RenderNodes from './RenderNodes.astro'

interface Props {
  /** A validated document: validateDocument(parseDocument(entry.body), registry).document. */
  document: ValidatedDocumentNode
  /**
   * Per-block Astro component overrides, keyed by block name. An override
   * receives the block's validated props spread as component props, plus
   * reserved `node` and `ctx` props; nested content arrives through the
   * default <slot />. Block props literally named "node" or "ctx" are shadowed.
  */
  components?: Record<string, unknown>
  /** Prose pipeline. Default: escaped paragraphs; pass your host Markdown renderer for full Markdown. */
  renderMarkdown?: AstroMarkdownRenderer
  /** Invalid-block behavior: throw, visible dev box, or escaped body. Default "annotated". */
  onInvalid?: 'strict' | 'annotated' | 'fallback'
}

const {
  document,
  components = {},
  renderMarkdown = defaultRenderMarkdown,
  onInvalid = 'annotated',
} = Astro.props
const ctx: AstroBlockContext = { renderMarkdown }
---

<RenderNodes
  nodes={document.children}
  components={components}
  ctx={ctx}
  onInvalid={onInvalid}
/>
