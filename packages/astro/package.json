{
  "name": "@contentbit/astro",
  "version": "0.6.1",
  "description": "Astro renderer for Content Blocks: .astro components for rendering validated documents, with per-block component overrides.",
  "keywords": [
    "astro",
    "astro-component",
    "content-blocks",
    "markdown",
    "renderer",
    "withastro"
  ],
  "homepage": "https://contentbit.dev",
  "bugs": "https://github.com/agonist/contentbit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agonist/contentbit.git",
    "directory": "packages/astro"
  },
  "files": [
    "dist",
    "components"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": "./components/index.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "node ../../scripts/require-pnpm-publish.mjs",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@contentbit/core": "workspace:*"
  },
  "devDependencies": {
    "@contentbit/blocks": "workspace:*",
    "@types/node": "^25.9.2",
    "astro": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
  }
}
