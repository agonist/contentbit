{
  "name": "contentbit-monorepo",
  "private": true,
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "version:sync": "node scripts/sync-version.mjs",
    "version:packages": "changeset version && pnpm version:sync",
    "version:check": "node scripts/check-versions.mjs",
    "changeset": "changeset",
    "release": "pnpm version:check && pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0"
  },
  "packageManager": "pnpm@11.5.0"
}
